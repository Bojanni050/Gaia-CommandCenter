# Gaia Server Control Center v0.1 Environment Variables
# Kopieer dit bestand naar .env en stel een veilig wachtwoord in.

# Inloggegevens voor het Control Center
ADMIN_USERNAME=admin
ADMIN_PASSWORD=wijzig-dit-wachtwoord-voor-productie

# JWT Geheim
SECRET_KEY=genereer-een-veilige-willekeurige-sleutel-voor-jwt

# Poort waarop het Control Center luistert
PORT=8899

# Host instellingen
TAILSCALE_HOST=100.65.0.15
DOCKER_SOCKET_PATH=/var/run/docker.sock
REGISTRY_PATH=/app/registry.yaml

# Foundation Ingestie Gateway (bron voor de Ingestie-tab)
# Het dashboard leest live GET /api/ingest-logs van Foundation.
FOUNDATION_API_URL=http://100.65.0.15:4577

# Bearer-token van Foundation (verplicht voor de Ingestie-tab; ook nodig als een
# registry-component een health endpoint achter auth heeft)
FOUNDATION_API_TOKEN=

# Optioneel: Bearer-token voor Gaia API health endpoints achter auth
# GAIA_API_TOKEN=
