# Gaia Server Control Center v0.1 Environment Variables
# Kopieer dit bestand naar .env en stel een veilig wachtwoord in.

# Inloggegevens voor het Control Center
ADMIN_USERNAME=admin
ADMIN_PASSWORD=wijzig-dit-wachtwoord-voor-productie

# JWT Geheim
SECRET_KEY=genereer-een-veilige-willekeurige-sleutel-voor-jwt

# Poort waarop het Control Center luistert
PORT=8899

# Host instellingen
TAILSCALE_HOST=100.65.0.15
DOCKER_SOCKET_PATH=/var/run/docker.sock
REGISTRY_PATH=/app/registry.yaml

# Optioneel: Bearer-tokens voor health endpoints achter auth
# (alleen nodig als een registry-component health_auth_env gebruikt)
# GAIA_API_TOKEN=
# FOUNDATION_API_TOKEN=
